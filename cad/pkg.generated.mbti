pub fn SweepProfile::new(Array[(Double, Double, Double)], center? : (Double, Double, Double), holes? : Array[Array[(Double, Double, Double)]], normal_dir? : (Double, Double, Double), right_dir? : (Double, Double, Double)) -> Self

