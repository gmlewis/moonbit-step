name = "gmlewis/step"

version = "0.1.19"

import {
  "gmlewis/base64@0.16.12",
  "gmlewis/flate@0.36.14",
  "gmlewis/fonts@0.19.16",
  "gmlewis/gzip@0.34.14",
  "gmlewis/io@0.23.17",
  "moonbitlang/async@0.21.3",
  "moonbitlang/x@0.5.5",
}

readme = "README.md"

repository = "https://github.com/gmlewis/moonbit-step"

license = "Apache-2.0"

keywords = [ "cad", "step", "3d", "modeling" ]

description = "Port of https://github.com/tscircuit/stepts to MoonBit"

preferred_target = "native"
