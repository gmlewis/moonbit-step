name = "gmlewis/step"

version = "0.2.1"

import {
  "gmlewis/base64@0.16.14",
  "gmlewis/flate@0.36.18",
  "gmlewis/fonts@0.19.20",
  "gmlewis/gzip@0.34.18",
  "gmlewis/io@0.23.21",
  "moonbitlang/async@0.22.9",
  "moonbitlang/x@0.5.7",
}

readme = "README.md"

repository = "https://github.com/gmlewis/moonbit-step"

license = "Apache-2.0"

keywords = [ "cad", "step", "3d", "modeling", "components" ]

description = "A high-level 3D modeling DSL and lossless STEP (ISO 10303-21) parser/serializer in MoonBit."

preferred_target = "native"
