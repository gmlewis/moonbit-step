///|
/// HubSeg is one segment of a measured goBILDA 1309 Sonic hub profile:
/// a straight line or a circular arc (start, end, centre, radius).
priv enum HubSeg {
  HubLine(Double, Double, Double, Double)
  HubArc(Double, Double, Double, Double, Double, Double, Double)
}

