///|
/// hub_loop converts measured segments into a closed analytic profile loop.
fn hub_loop(segs : Array[HubSeg]) -> Array[@cad.ProfileSegment] {
  segs.map(fn(seg) {
    match seg {
      HubLine(ax, ay, bx, by) => @cad.SegmentLine((ax, ay), (bx, by))
      HubArc(ax, ay, bx, by, cx, cy, _r) =>
        @cad.SegmentArc((ax, ay), (bx, by), (cx, cy))
    }
  })
}
