ISO-10303-21;
HEADER;
/*
  Component:  ISO 4762 - M4 x 20
  Standard:   ISO 4762:2004
  Family:     hexagon socket head cap screw
  Size:       M4
  Length:     20 mm
  Data source: ISO 4762:2004 head/socket table; nominal values, see components/DATA_SOURCES.md
  Notes:      Layered solid: plain shank, head floor, blind hex socket. Socket represented by a ring with a through hex hole over a floor disc. The head top edge carries a 45-degree chamfer (engineering default). A swept helical thread ridge is modeled.
  Features modeled:      head-floor, blind-hex-socket, head-chamfer, helical-thread
  Features approximated: head-socket-band (PolygonRevolve, deviation 0.0042159032818965825 mm, control circle_segments=64); helical-ridge (SweptSpline, deviation 0.015165423314295086 mm, control segments_per_turn=24)
  Features omitted:      shank-tip-chamfer (not modelled by this builder); under-head-radius (not modelled by this builder); socket-lead-in-chamfer (not modelled by this builder); thread-runout (the swept ridge ends at the shank ends; thread runout and lead-in are not modelled)
  Feature tolerance:     0.01 mm
*/
FILE_DESCRIPTION(('ISO 4762 - M4 x 20'),'2;1');
FILE_NAME('ISO4762-M4-20.step','2026-11-11T01:02:42',('gmlewis'),('gmlewis/step','https://github.com/gmlewis/moonbit-step'),'gmlewis/step','moonbit','none');
