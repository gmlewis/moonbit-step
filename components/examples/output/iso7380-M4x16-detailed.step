ISO-10303-21;
HEADER;
/*
  Component:  ISO 7380-1 - M4 x 16
  Standard:   ISO 7380-1:2022
  Family:     button head hexagon socket screw
  Size:       M4
  Length:     16 mm
  Data source: ISO 7380-1 button head table; nominal values transcribed from published summaries, see components/DATA_SOURCES.md
  Notes:      Button head with a spherical-cap dome, flat top, and hexagon socket. The dome is an analytic spherical surface; the socket band is a high-resolution polygon with a real hex through-hole. No thread geometry is modeled.
  Features modeled:      blind-hex-socket, head-dome-sphere, socket-lead-in-chamfer, shank-tip-chamfer
  Features approximated: head-socket-band (PolygonRevolve, deviation 0.0045772664203448605 mm, control circle_segments=64); socket-lead-in-band (PolygonRevolve, deviation 0.0045772664203448605 mm, control hex-hole ruled lead-in, circle_segments=64)
  Features omitted:      under-head-radius (no verified standard value; a typed omission rather than a guessed fillet); thread (no thread geometry at this detail level)
  Feature tolerance:     0.01 mm
*/
FILE_DESCRIPTION(('ISO 7380-1 - M4 x 16'),'2;1');
