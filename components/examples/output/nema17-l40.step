ISO-10303-21;
HEADER;
/*
  Component:  NEMA17 stepper motor, 40 mm body
  Standard:   NEMA motor frame interface (frame, bolt spacing, mounting holes, pilot, shaft)
  Family:     stepper motor envelope
  Size:       NEMA17
  Length:     40 mm
  Data source: NEMA frame interface dimensions; body and shaft lengths are envelope parameters. The step.parts reference confirms frame, bolt spacing, mounting holes, and shaft.
  Notes:      NEMA stepper-motor envelope: square body with four mounting holes, front pilot boss, and plain shaft. Stator, windings, terminals, rear shaft, and shaft flat are omitted.
  Features modeled:      body, mounting-hole-pattern, pilot-boss, shaft
  Features omitted:      stator-laminations (internal motor construction is not modelled); windings-and-terminals (electrical internals and connectors are not modelled); rear-shaft (this builder models the single-shaft configuration); shaft-flat-or-keyway (the shaft is a plain cylinder; motor shafts vary)
  Feature tolerance:     0.01 mm
*/
FILE_DESCRIPTION(('NEMA17 stepper motor, 40 mm body'),'2;1');
FILE_NAME('NEMA17-stepper-40.step','2026-11-13T12:56:20',('gmlewis'),('gmlewis/step','https://github.com/gmlewis/moonbit-step'),'gmlewis/step','moonbit','none');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
