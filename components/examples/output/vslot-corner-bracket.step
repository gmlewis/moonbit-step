ISO-10303-21;
HEADER;
/*
  Component:  V-Slot corner bracket 20 x 20 x 3
  Standard:   Generic 20-series V-Slot corner bracket
  Family:     V-Slot corner bracket
  Size:       20x20x3
  Data source: Parametric gusseted corner bracket: two slotted legs plus two 45-degree side gussets. The default dimensions reproduce the Xem Studio corner-bracket-20 reference (CC BY 4.0); no vendor part is claimed.
  Notes:      Layered V-Slot corner bracket with one M5-clearance obround slot in each leg and two side gussets. Faces touch but do not overlap. No casting draft, edge fillets, or locating tabs are modelled.
  Features modeled:      base-leg, side-leg, through-slots, side-gussets
  Features approximated: gusset-profile (EngineeringDefault, deviation 0 mm, control flat 45-degree triangular gusset; the cast reference has draft and a rounded web)
  Features omitted:      casting-draft (the parametric form keeps prismatic faces); edge-fillets (no edge treatment is asserted); locating-tabs (the vendor cast bracket's 4 mm slot tabs are not modelled)
  Feature tolerance:     0.01 mm
*/
FILE_DESCRIPTION(('V-Slot corner bracket 20 x 20 x 3'),'2;1');
FILE_NAME('vslot-corner-bracket-20.step','2026-11-13T17:46:16',('gmlewis'),('gmlewis/step','https://github.com/gmlewis/moonbit-step'),'gmlewis/step','moonbit','none');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
