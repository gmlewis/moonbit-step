ISO-10303-21;
HEADER;
/*
  Component:  Extrusion T-nut M3, slot 5 mm
  Standard:   generic extrusion T-nut envelope (step.parts dimensions)
  Family:     extrusion T-nut
  Size:       M3
  Length:     2.4 mm
  Material:   steel (label only; not a structural claim)
  Data source: Hex body across flats and thickness from the step.parts extrusion-nut envelope; slot width is an engagement parameter. All catalogue styles share this body.
  Notes:      Generic hex-body extrusion T-nut: regular hexagonal prism with a central thread-envelope hole. The reference catalogue uses the same body for slide-in, drop-in, and hammer styles, so no style-specific retention feature is claimed.
  Features modeled:      body, hexagonal-prism, through-hole
  Features omitted:      thread-helix (the bore is the thread envelope, not a modeled helix); spring-ball (retention hardware is not modelled); style-specific-retention (the reference catalogue uses the same body for slide-in, drop-in, and hammer styles)
  Feature tolerance:     0.01 mm
*/
FILE_DESCRIPTION(('Extrusion T-nut M3, slot 5 mm'),'2;1');
FILE_NAME('TNUT-M3-slot5.step','2026-11-13T03:15:30',('gmlewis'),('gmlewis/step','https://github.com/gmlewis/moonbit-step'),'gmlewis/step','moonbit','none');
