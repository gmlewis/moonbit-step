ISO-10303-21;
HEADER;
/*
  Component:  Counterbored plate 50 x 40 x 8
  Standard:   
  Family:     counterbored plate
  Size:       50x40x8
  Data source: Parametric counterbored plate: a through hole plus a cylindrical counterbore on the top face. Hole positions are caller-supplied; no standard pattern is implied.
  Notes:      Rectangular plate with counterbored through holes. Two touching layers form the stepped bore; no countersink, edge treatment, or material tolerance is asserted.
  Features modeled:      body, through-holes, counterbores
  Features omitted:      countersink (this builder makes cylindrical counterbores only; conical countersinks are not modelled); edge-chamfer (not modelled by this builder)
  Feature tolerance:     0.01 mm
*/
FILE_DESCRIPTION(('Counterbored plate 50 x 40 x 8'),'2;1');
