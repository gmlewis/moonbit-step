HEADER;
/*
  Assembly:   hardware-kit-M4-20
  Instances:  3
  Description: Socket head cap screw with flat washer and hex nut, separated along the screw axis.
    screw = ISO 4762 - M4 x 20 (ISO 4762:2004)
    washer = ISO 7089 - M4 (ISO 7089:2000)
    nut = ISO 4032 - M4 (ISO 4032:2023)
*/
