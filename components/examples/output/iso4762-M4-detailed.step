ISO-10303-21;
HEADER;
/*
  Component:  ISO 4762 - M4 x 20
  Standard:   ISO 4762:2004
  Family:     hexagon socket head cap screw
  Size:       M4
  Length:     20 mm
  Data source: ISO 4762:2004 head/socket table; nominal values, see components/DATA_SOURCES.md
  Notes:      Layered solid: plain shank, head floor, blind hex socket. Socket represented by a ring with a through hex hole over a floor disc. The head top edge, the socket rim, and the shank tip carry 45-degree chamfers (engineering defaults). No thread geometry is modeled.
  Features modeled:      head-floor, blind-hex-socket, head-chamfer, socket-lead-in-chamfer, shank-tip-chamfer
  Features approximated: head-socket-band (PolygonRevolve, deviation 0.0042159032818965825 mm, control circle_segments=64); socket-lead-in-band (PolygonRevolve, deviation 0.0042159032818965825 mm, control hex-hole ruled lead-in, circle_segments=64)
  Features omitted:      under-head-radius (ISO 4762 does not give a verified under-head radius for this builder; a typed omission rather than a guessed fillet); thread (no thread geometry at this detail level)
  Feature tolerance:     0.01 mm
*/
FILE_DESCRIPTION(('ISO 4762 - M4 x 20'),'2;1');
