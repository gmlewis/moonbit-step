ISO-10303-21;
HEADER;
/*
  Component:  Heat-set insert M3, 6 mm
  Standard:   generic heat-set insert envelope (step.parts dimensions)
  Family:     heat-set threaded insert
  Size:       M3
  Length:     6 mm
  Material:   brass (label only; not a strength claim)
  Data source: Step.parts M3 short and long heat-set insert envelopes: 6.0 mm body, 6.48 mm knurl, 2.25 mm bore, knurl bands at 20-32% and 68-80% of length.
  Notes:      Heat-set threaded-insert envelope: plain body with two raised cylindrical knurl bands and a through bore. The bore is a thread envelope; diamond knurl and pull-out strength are not modeled.
  Features modeled:      body, through-bore, two-knurl-bands
  Features omitted:      thread-helix (the bore is the thread envelope, not a modeled helix); diamond-knurl (the knurl is represented by raised cylindrical bands); installation-strength (pull-out and torque strength require testing, not geometry)
  Feature tolerance:     0.01 mm
*/
FILE_DESCRIPTION(('Heat-set insert M3, 6 mm'),'2;1');
FILE_NAME('HEATSET-M3-6.step','2026-11-13T03:15:30',('gmlewis'),('gmlewis/step','https://github.com/gmlewis/moonbit-step'),'gmlewis/step','moonbit','none');
