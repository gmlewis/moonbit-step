HEADER;
/*
  Component:  Bearing plate 22.1 seat for OD 22
  Standard:   
  Family:     bearing-to-printed housing plate
  Size:       50x40x6
  Data source: Parametric printed housing plate: a central bearing seat and two fastener clearance holes. The seat fit is declared by the caller; printer shrinkage, material, and retention are not modelled.
  Notes:      Flat plate with a central bearing seat and two free-clearance bolt holes. The seat fit is a geometric declaration (declared radial clearance of 0.1 mm), not a strength or retention claim.
  Features modeled:      body, through-holes, through-slots
  Features omitted:      edge-chamfers (no edge treatment is asserted); material-and-tolerances (the plate is a nominal geometric blank)
  Feature tolerance:     0.01 mm
*/
FILE_DESCRIPTION(('Bearing plate 22.1 seat for OD 22'),'2;1');
