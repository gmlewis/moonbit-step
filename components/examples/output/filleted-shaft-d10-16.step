ISO-10303-21;
HEADER;
/*
  Component:  Filleted stepped shaft
  Standard:   
  Family:     stepped shaft
  Size:       2 steps
  Data source: Parametric solid of revolution with circular shoulder fillets; no standard table is implied.
  Notes:      Stepped shaft with toroidal shoulder fillets on increasing steps. Decreasing steps and steps too short for the fillet stay sharp.
  Features modeled:      body, shoulder-fillet
  Features omitted:      keyway (not modelled; represent it with an evaluated cut)
  Feature tolerance:     0.01 mm
*/
FILE_DESCRIPTION(('Filleted stepped shaft'),'2;1');
FILE_NAME('filleted-shaft-2-step.step','2026-11-10T13:14:36',('gmlewis'),('gmlewis/step','https://github.com/gmlewis/moonbit-step'),'gmlewis/step','moonbit','none');
