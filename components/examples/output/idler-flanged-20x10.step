ISO-10303-21;
HEADER;
/*
  Component:  Smooth idler OD 20 / bore 8 x 10
  Standard:   
  Family:     smooth idler
  Size:       
  Length:     13 mm
  Data source: Generic parametric smooth idler: hub tube plus optional annular end flanges. No vendor part or bearing-seat tolerance is implied.
  Notes:      Smooth idler (toothless pulley) with a through bore and optional annular end flanges. Layered analytic cylinders; no bearing rating or belt-tension claim.
  Features modeled:      hub, through-bore, end-flanges
  Features omitted:      bearing-seat-tolerance (the bore is a nominal cylindrical hole; no bearing fit or tolerance class is asserted); edge-chamfer (not modelled by this builder)
  Feature tolerance:     0.01 mm
*/
FILE_DESCRIPTION(('Smooth idler OD 20 / bore 8 x 10'),'2;1');
