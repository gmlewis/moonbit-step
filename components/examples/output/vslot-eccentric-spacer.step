ISO-10303-21;
HEADER;
/*
  Component:  V-Slot eccentric spacer AF 10 x 6, pilot 7.11 x 2.5
  Standard:   OpenBuilds eccentric wheel spacer (boundary dimensions)
  Family:     V-Slot eccentric spacer
  Size:       
  Length:     8.5 mm
  Data source: Hex body across flats 10 mm, hex height 6 mm, pilot 7.11 mm x 2.5 mm, 5 mm bore, 0.79 mm eccentricity, as listed by OpenBuilds resellers and the ink.parts reference frame. Overall axial stack = hex height + pilot length.
  Notes:      Hex eccentric spacer with an offset 5 mm bore and a 7.11 mm pilot that fits the 7.12 mm wheel hole. The seating shoulder is z = 0, the hex is on -Z, and the pilot is on +Z. No divot, finish, or tolerance class is modelled.
  Features modeled:      hex-body, offset-bore, cylindrical-pilot
  Features omitted:      divot-marker (the vendor marks the small side of the cam with a divot; it is a visual marker, not a mating feature); across-flats-finish (no wrench-flat finish or tolerance class is asserted)
  Feature tolerance:     0.01 mm
*/
FILE_DESCRIPTION(('V-Slot eccentric spacer AF 10 x 6, pilot 7.11 x 2.5'),'2;1');
FILE_NAME('vslot-eccentric-spacer-10.step','2026-11-13T17:46:16',('gmlewis'),('gmlewis/step','https://github.com/gmlewis/moonbit-step'),'gmlewis/step','moonbit','none');
