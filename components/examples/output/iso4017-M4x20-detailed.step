ISO-10303-21;
HEADER;
/*
  Component:  ISO 4017 - M4 x 20
  Standard:   ISO 4017:2014
  Family:     hexagon head screw, fully threaded
  Size:       M4
  Length:     20 mm
  Data source: ISO 4017:2014 hexagon head screw, product grades A and B; nominal values, see components/DATA_SOURCES.md
  Notes:      Hexagon head screw; layered body and head. At Detailed and above the head top edge and the shank tip carry 45-degree engineering chamfers. No thread geometry is modeled.
  Features modeled:      hex-head, hex-body, hex-head-chamfer, shank-tip-chamfer
  Features approximated: hex-head-chamfer-band (PolygonRevolve, deviation 1.0829037686547602 mm, control parallel-inset hexagon ruled chamfer)
  Features omitted:      under-head-radius (no verified standard value; a typed omission rather than a guessed fillet); head-washer-face (the characteristic conical hexagon-head chamfer is modelled as a parallel-inset ruled approximation, not a true washer face); thread (no thread geometry at this detail level)
  Feature tolerance:     0.01 mm
*/
FILE_DESCRIPTION(('ISO 4017 - M4 x 20'),'2;1');
