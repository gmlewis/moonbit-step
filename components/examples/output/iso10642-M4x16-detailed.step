ISO-10303-21;
HEADER;
/*
  Component:  ISO 10642 - M4 x 16
  Standard:   ISO 10642:2004
  Family:     countersunk head hexagon socket screw
  Size:       M4
  Length:     16 mm
  Data source: ISO 10642 countersunk head table; nominal values transcribed from published summaries, see components/DATA_SOURCES.md
  Notes:      Countersunk head (90-degree included angle) with a hexagon socket. The socket floor is an analytic revolved head; the socket band is a high-resolution polygon with a real hex through-hole. No thread geometry is modeled.
  Features modeled:      blind-hex-socket, head-countersink-cone, socket-lead-in-chamfer, shank-tip-chamfer
  Features approximated: head-socket-band (PolygonRevolve, deviation 0.0050590839382758995 mm, control circle_segments=64); socket-lead-in-band (PolygonRevolve, deviation 0.0050590839382758995 mm, control hex-hole ruled lead-in, circle_segments=64)
  Features omitted:      under-head-radius (no verified standard value; a typed omission rather than a guessed fillet); thread (no thread geometry at this detail level)
  Feature tolerance:     0.01 mm
*/
FILE_DESCRIPTION(('ISO 10642 - M4 x 16'),'2;1');
