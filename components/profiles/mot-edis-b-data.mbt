///|
/// BSeg is one measured segment of a MotEDis B-type profile section:
/// a straight line or a circular arc (start, end, centre, radius).
priv enum BSeg {
  BLine(Double, Double, Double, Double)
  BArc(Double, Double, Double, Double, Double, Double, Double)
}

