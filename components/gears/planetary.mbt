///|
/// internal_ring_gear_profile returns an approximate internal-ring bore
/// boundary in the XY plane.
///
/// The tooth form is a trapezoidal approximation, not the exact involute
/// envelope of a generated planet. Tips point inward at `rp - m`; root
/// material reaches `rp + 1.25 m`. `tooth_fraction` controls how much of the
/// angular pitch is tooth tip.
pub fn internal_ring_gear_profile(
  module_mm : Double,
  teeth : Int32,
  tooth_fraction~ : Double = 0.35,
  tip_points~ : Int32 = 3,
  root_points~ : Int32 = 4,
) -> Array[@cad.Vec2] {
  let pitch = module_mm * teeth.to_double() / 2.0
  let tip_radius = pitch - module_mm
  let root_radius = pitch + 1.25 * module_mm
  let pitch_angle = 2.0 * @math.PI / teeth.to_double()
  let tip_half = pitch_angle * tooth_fraction / 2.0
  let gap_half = pitch_angle / 2.0 - tip_half
  let tip_n = if tip_points < 2 { 2 } else { tip_points }
  let root_n = if root_points < 2 { 2 } else { root_points }
  let out : Array[@cad.Vec2] = []
  for i in 0..<teeth {
    let center = i.to_double() * pitch_angle
    // Tip arc (tooth points inward).
    for k in 0..<tip_n {
      let t = if tip_n == 1 {
        center
      } else {
        center -
        tip_half +
        2.0 * tip_half * k.to_double() / (tip_n - 1).to_double()
      }
      out.push((tip_radius * @math.cos(t), tip_radius * @math.sin(t)))
    }
    // Root arc (material between teeth).
    let root_start = center + tip_half
    let root_span = pitch_angle - 2.0 * tip_half
    let _ = gap_half
    for k in 0..<root_n {
      let t = if root_n == 1 {
        root_start
      } else {
        root_start + root_span * k.to_double() / (root_n - 1).to_double()
      }
      out.push((root_radius * @math.cos(t), root_radius * @math.sin(t)))
    }
  }
  out
}

///|
/// internal_ring_gear builds an approximate internal ring gear body.
///
/// Axis +Z, base at z = 0. The outer boundary is circular; the bore is the
/// toothed internal profile. The tooth form is trapezoidal and is explicitly
/// not an exact involute internal gear.
pub fn internal_ring_gear(
  module_mm : Double,
  teeth : Int32,
  face_width_mm : Double,
  pressure_angle_deg~ : Double = 20.0,
  outer_wall_mm~ : Double = 5.0,
  tooth_fraction~ : Double = 0.35,
  detail~ : @common.DetailLevel = Detailed,
) -> Result[@common.Component, @common.SpecError] {
  match @common.require_positive("ring module", module_mm) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  if teeth < 6 {
    return Err(@common.InvalidParameter("ring teeth must be >= 6"))
  }
  match @common.require_positive("ring face width", face_width_mm) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  match @common.require_positive("ring outer wall", outer_wall_mm) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  match
    @common.require_in_range("pressure angle", pressure_angle_deg, 10.0, 35.0) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  let pitch = module_mm * teeth.to_double() / 2.0
  let root_radius = pitch + 1.25 * module_mm
  let outer_radius = root_radius + outer_wall_mm
  let bore = internal_ring_gear_profile(module_mm, teeth, tooth_fraction~).rev()
  let policy = @common.DetailPolicy::for_level(detail)
  let segments = if policy.circle_segments < 48 {
    48
  } else {
    policy.circle_segments
  }
  let outer = @cad.Profile2D::circle(2.0 * outer_radius, segments~)
  let body = @cad.ExtrudedProfile::new(outer, face_width_mm, holes=[bore])
  let name = "ring-gear-m\{@cad.fmt_double(module_mm, None)}-z\{teeth}"
  Ok(
    @common.Component::new(
      name~,
      metadata=@common.Metadata::new(
        designation="Internal ring gear m\{@cad.fmt_double(module_mm, None)} z\{teeth}",
        standard="Approximate internal tooth form (not ISO 21771 exact)",
        family="internal ring gear",
        size="m\{@cad.fmt_double(module_mm, None)}-z\{teeth}",
        source="Trapezoidal internal tooth approximation generated by this library; verify against a designed internal gear before load-bearing use.",
      ),
      description="Circular ring with an approximate toothed bore. Tooth flanks are straight; no involute internal envelope, root fillet, or relief is modeled.",
      features=@common.FeatureRecord::new(
        modeled=["body"],
        approximated=[
          @common.Approximation::new(
            feature="internal-tooth-form",
            kind=@common.ApproximationKind::PolylineArc,
            deviation_mm=0.0,
            control="tooth_fraction, tip_points, root_points",
          ),
          @common.Approximation::new(
            feature="outer-boundary",
            kind=@common.ApproximationKind::PolylineArc,
            deviation_mm=@common.chord_deviation(outer_radius, segments),
            control="circle_segments=\{segments}",
          ),
        ],
        omitted=[
          @common.Omission::new(
            feature="exact-involute-internal-envelope",
            reason="the ring uses a trapezoidal tooth approximation",
          ),
          @common.Omission::new(
            feature="root-fillet",
            reason="not modelled by this builder",
          ),
          @common.Omission::new(
            feature="tip-chamfer",
            reason="not modelled by this builder",
          ),
        ],
      ),
    ).add_layer(body, name="body", color=@cad.Rgb::purple()),
  )
}

///|
/// PlanetaryParams is a validated straight-spur planetary gear set request.
pub(all) struct PlanetaryParams {
  module_mm : Double
  sun_teeth : Int32
  planet_teeth : Int32
  ring_teeth : Int32
  planet_count : Int32
  pressure_angle_deg : Double
  face_width_mm : Double
  sun_bore_mm : Double
  planet_bore_mm : Double
  backlash_mm : Double
}

///|
/// PlanetaryParams::new validates the tooth counts and assembly condition.
pub fn PlanetaryParams::new(
  module_mm~ : Double,
  sun_teeth~ : Int32,
  planet_teeth~ : Int32,
  planet_count~ : Int32 = 3,
  pressure_angle_deg~ : Double = 20.0,
  face_width_mm~ : Double = 10.0,
  sun_bore_mm~ : Double = 0.0,
  planet_bore_mm~ : Double = 0.0,
  backlash_mm~ : Double = 0.0,
) -> Result[PlanetaryParams, @common.SpecError] {
  match @common.require_positive("module", module_mm) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  if sun_teeth < 6 || planet_teeth < 6 {
    return Err(
      @common.InvalidParameter("sun and planet teeth must both be >= 6"),
    )
  }
  if planet_count < 1 {
    return Err(@common.InvalidParameter("planet count must be >= 1"))
  }
  let ring_teeth = sun_teeth + 2 * planet_teeth
  if (sun_teeth + ring_teeth) % planet_count != 0 {
    return Err(
      @common.InvalidParameter(
        "tooth counts cannot be equally spaced: (sun + ring) must be divisible by the planet count",
      ),
    )
  }
  // Validate each gear's own bore and pressure angle.
  let sun = match
    SpurGearParams::new(
      module_mm~,
      teeth=sun_teeth,
      pressure_angle_deg~,
      face_width_mm~,
      bore_diameter_mm=sun_bore_mm,
      backlash_mm~,
    ) {
    Err(e) => return Err(e)
    Ok(p) => p
  }
  let planet = match
    SpurGearParams::new(
      module_mm~,
      teeth=planet_teeth,
      pressure_angle_deg~,
      face_width_mm~,
      bore_diameter_mm=planet_bore_mm,
      backlash_mm~,
    ) {
    Err(e) => return Err(e)
    Ok(p) => p
  }
  let _ = (sun, planet)
  Ok({
    module_mm,
    sun_teeth,
    planet_teeth,
    ring_teeth,
    planet_count,
    pressure_angle_deg,
    face_width_mm,
    sun_bore_mm,
    planet_bore_mm,
    backlash_mm,
  })
}

///|
/// PlanetaryParams::center_distance returns the sun/planet centre distance.
pub fn PlanetaryParams::center_distance(self : PlanetaryParams) -> Double {
  self.module_mm * (self.sun_teeth + self.planet_teeth).to_double() / 2.0
}

///|
/// PlanetaryParams::designation returns a compact set designation.
pub fn PlanetaryParams::designation(self : PlanetaryParams) -> String {
  "m\{@cad.fmt_double(self.module_mm, None)}-s\{self.sun_teeth}-p\{self.planet_teeth}-r\{self.ring_teeth}-\{self.planet_count}"
}

///|
/// PlanetaryParams::internal_mesh_backlash returns the circumferential backlash
/// used for the internal ring mesh.
///
/// A declared backlash of `0.05 * module` is applied by default. A low planet
/// tooth count (for example z = 12 at 20 degrees) produces a ring tooth tip
/// that grazes the planet flank through part of the rotation cycle; the small
/// backlash clears it. This is a documented engineering default, not a
/// standards-mandated value. A caller-supplied positive backlash overrides it.
pub fn PlanetaryParams::internal_mesh_backlash(
  self : PlanetaryParams,
) -> Double {
  if self.backlash_mm > 0.0 {
    self.backlash_mm
  } else {
    0.05 * self.module_mm
  }
}

///|
/// planetary_gear_set builds a straight-spur planetary set: sun, planets, and an
/// exact internal involute ring gear.
///
/// The ring uses `internal_ring_gear_exact`, whose tooth thickness follows the
/// internal involute relation, so the planet tooth space is conjugate through a
/// rotation cycle. See `internal_mesh_interference`, which the tests use to
/// prove zero outline crossings. The assembly condition
/// `ring = sun + 2 * planet` and `(sun + ring) % planet_count == 0` is enforced.
///
/// The layout is geometric: it is a static pose, not a solved kinematic train.
pub fn planetary_gear_set(
  params : PlanetaryParams,
  detail~ : @common.DetailLevel = Detailed,
) -> Result[@assemblies.Assembly, @common.SpecError] {
  let backlash = params.internal_mesh_backlash()
  let sun = match
    SpurGearParams::new(
      module_mm=params.module_mm,
      teeth=params.sun_teeth,
      pressure_angle_deg=params.pressure_angle_deg,
      face_width_mm=params.face_width_mm,
      bore_diameter_mm=params.sun_bore_mm,
      backlash_mm=backlash,
    ) {
    Err(e) => return Err(e)
    Ok(p) => p
  }
  let planet = match
    SpurGearParams::new(
      module_mm=params.module_mm,
      teeth=params.planet_teeth,
      pressure_angle_deg=params.pressure_angle_deg,
      face_width_mm=params.face_width_mm,
      bore_diameter_mm=params.planet_bore_mm,
      backlash_mm=backlash,
    ) {
    Err(e) => return Err(e)
    Ok(p) => p
  }
  let sun_component = match spur_gear(sun, detail~) {
    Err(e) => return Err(e)
    Ok(c) => c
  }
  let planet_component = match spur_gear(planet, detail~) {
    Err(e) => return Err(e)
    Ok(c) => c
  }
  let ring = match
    internal_ring_gear_exact(
      params.module_mm,
      params.ring_teeth,
      params.face_width_mm,
      pressure_angle_deg=params.pressure_angle_deg,
      backlash_mm=backlash,
      detail~,
    ) {
    Err(e) => return Err(e)
    Ok(c) => c
  }
  let center = params.center_distance()
  let name = "planetary-\{params.designation()}"
  let sun_pitch_deg = 360.0 / params.sun_teeth.to_double()
  let mut assembly = @assemblies.Assembly::new(
    name~,
    description="Straight-spur planetary set with an exact internal involute ring gear. Static layout; no kinematics.",
  ).add(sun_component, instance_name="sun")
  for j in 0..<params.planet_count {
    let theta = 360.0 * j.to_double() / params.planet_count.to_double()
    let rad = theta * @math.PI / 180.0
    let x = center * @math.cos(rad)
    let y = center * @math.sin(rad)
    // The planet's tooth/space phase must follow the sun tooth phase at the
    // line of centres. For planet angles that are exact multiples of the sun
    // pitch the offset is zero; otherwise the teeth would interfere even
    // though the standard (sun + ring) % planet_count condition holds.
    let sun_offset_deg = theta - (theta / sun_pitch_deg).round() * sun_pitch_deg
    let phase = theta +
      180.0 +
      180.0 / params.planet_teeth.to_double() +
      sun_offset_deg *
      params.sun_teeth.to_double() /
      params.planet_teeth.to_double()
    assembly = assembly.add(
      planet_component,
      placement=@common.Placement::at(x, y, 0.0, rz=phase),
      instance_name="planet-\{j + 1}",
    )
  }
  assembly = assembly.add(ring, instance_name="ring")
  Ok(assembly)
}
